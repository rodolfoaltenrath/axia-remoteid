[Desktop Entry]
Type=Application
Version=1.0
Name=Axia RemotedID Alpha
Comment=Certificados digitais em nuvem no Linux
Exec=/usr/bin/axia-remotedid gui
TryExec=/usr/bin/axia-remotedid
Icon=dialog-password
Terminal=false
Categories=System;Security;
Actions=Browsers;

[Desktop Action Browsers]
Name=Configurar navegadores
Exec=/usr/bin/axia-remotedid setup-browsers
